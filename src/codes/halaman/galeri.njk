---
layout: layout.njk
pagination:
  data: galeri
  size: 1
  alias: galeri
permalink: "/codes/halaman/galeri/{{galeri.merk}}/index.html"
---

<div class="d-flex justify-content-center mt-0">
  <img src="/public/images/{{galeri.bannerMerk1}}" class="banner" />
</div>
<div class="d-flex justify-content-center">
  <img src="/public/images/{{galeri.bannerMerk2}}" class="banner" />
</div>

<div class="d-flex align-items-center mt-5">
  <div class="dropdown" data-bs-theme="dark">
    <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      Pilih Merk
    </button>
    <ul class="dropdown-menu transition-all">
      <li><a class="dropdown-item" href="../Produk/">Default</a></li>
      <li><a class="dropdown-item" href="../ASUS/">ASUS</a></li>
      <li><a class="dropdown-item" href="../MSI/">MSI</a></li>
      <li><a class="dropdown-item" href="../Lenovo/">Lenovo</a></li>
      <li><a class="dropdown-item" href="../Acer/">Acer</a></li>
    </ul>
  </div>
  <div class="headline productlabel" style="font-size: 30px;">
    {{galeri.merk}}
  </div>
</div>

<div class="container mt-4 mb-5">
  <div class="row justify-content-center gap-4">
    <div class="col pt-3 mr-3 mw-440p rounded boxshadow" style="background-color: rgb(12, 3, 37)">
      <a href="/_site/codes/halaman/{{galeri.produk1Link}}">
        <img src="/public/images/{{galeri.produk1}}" alt="asustuf" height="200px" class="dropshadow transition-all scaleup mx-auto d-block" />
      </a>
      <div>
        <p class="headline h3 text-center mt-4">
          {{galeri.namaProduk1}}<br>
          {{galeri.hargaProduk1}}
        </p>
        <p class="text-center text-white mt-5 mb-5 poppins">
          {{galeri.cpuProduk1}} <br>
          {{galeri.gpuProduk1}} <br>
          {{galeri.displayProduk1}} <br>
          {{galeri.ramProduk1}} <br>
          {{galeri.storageProduk1}} <br>
          {{galeri.dimensionProduk1}} <br>
          {{galeri.osProduk1}}
        </p>
      </div>
    </div>

    <div class="col pt-3 mr-3 mw-440p rounded boxshadow" style="background-color: rgb(12, 3, 37)">
      <a href="/_site/codes/halaman/{{galeri.produk2Link}}">
        <img src="/public/images/{{galeri.produk2}}" alt="asustuf" height="200px" class="dropshadow transition-all scaleup mx-auto d-block" />
