          {{galeri.displayProduk2}} <br>
          {{galeri.ramProduk2}} <br>
          {{galeri.storageProduk2}} <br>
          {{galeri.dimensionProduk2}} <br>
          {{galeri.osProduk2}}
        </p>
      </div>
    </div>

    <div class="col pt-3 mr-3 mw-440p rounded boxshadow" style="background-color: rgb(12, 3, 37)">
      <a href="/_site/codes/halaman/{{galeri.produk3Link}}">
        <img src="/public/images/{{galeri.produk3}}" alt="asustuf" height="200px" class="dropshadow transition-all scaleup mx-auto d-block" />
